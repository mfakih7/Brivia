# =============================================================================
# BRIVIA production environment TEMPLATE (Namecheap shared hosting, https://brivia.tech)
#
# Copy to /home/fitcbfra/brivia-app/.env ON THE SERVER, fill in every <PLACEHOLDER>, then:
#   chmod 600 /home/fitcbfra/brivia-app/.env
# Never commit the real .env, never paste its values into chat, tickets or GitHub.
# =============================================================================

APP_NAME=BRIVIA
APP_ENV=production
APP_DEBUG=false
# Generate ONCE (see DEPLOYMENT.md §3) and keep it forever. Changing it breaks encrypted
# sessions/cookies. The deploy script never creates or replaces it.
APP_KEY=<BASE64_APP_KEY>
APP_URL=https://brivia.tech

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Daily files in storage/logs, kept 14 days; "warning" avoids logging routine noise.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# cPanel → MySQL Databases. The password is entered here privately on the server only.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fitcbfra_brivia
DB_USERNAME=fitcbfra_brivia
DB_PASSWORD=<DATABASE_PASSWORD>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# Approved images are served from /storage (public/storage symlink). Optional CDN base URL:
# PUBLIC_STORAGE_URL=

# Email (see DEPLOYMENT.md §6). Example for a cPanel/Namecheap mailbox on this domain:
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<MAIL_HOST e.g. mail.brivia.tech>
MAIL_PORT=465
MAIL_USERNAME=<MAILBOX e.g. no-reply@brivia.tech>
MAIL_PASSWORD=<MAILBOX_PASSWORD>
MAIL_FROM_ADDRESS=<no-reply@brivia.tech>
MAIL_FROM_NAME="${APP_NAME}"

# --- BRIVIA ---
# Comma-separated staff inboxes that receive new enquiry/appointment alerts.
BRIVIA_STAFF_NOTIFICATION_EMAILS=<team@brivia.tech>
BRIVIA_STAFF_TIMEZONE=Asia/Beirut
# Shared hosting has no daemons: the 5-minute scheduler runs a bounded queue worker. Keep true here.
BRIVIA_SCHEDULER_QUEUE_WORKER=true
BRIVIA_QUEUE_WORKER_MAX_SECONDS=240
# Turn on only after HTTPS works for brivia.tech AND every subdomain (HSTS is sticky in browsers).
BRIVIA_HSTS=false
# Leave empty on Namecheap shared hosting unless a proxy/CDN (e.g. Cloudflare) sits in front.
TRUSTED_PROXIES=
